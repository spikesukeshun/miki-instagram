{
  // LP を Cloudflare Workers の静的アセットとして配信する設定。
  //
  //   公開URL: https://www.esthe-miki.workers.dev/
  //            └ Worker名 "www" が先頭ラベル、"esthe-miki" はアカウントのサブドメイン
  //
  // デプロイ（⚠ wrangler は Node 22+ が必要。既定は v20 なので nvm で切り替える）:
  //   /usr/bin/python3 lp/tools/build_site.py
  //   source ~/.nvm/nvm.sh && nvm use 24 && npx wrangler deploy --config lp/wrangler.jsonc
  //
  // ⚠ HTML を Worker のスクリプトに埋め込まないこと。静的アセットは別枠（1ファイル25MBまで）
  //    なので画像もHTMLもここで賄える。

  "name": "www",
  "compatibility_date": "2026-08-14",

  // サロン用に作った専用アカウント（s.bsb.o.s1+miki@gmail.com）。
  // ⚠ 明示しないと、将来このログインが複数アカウントを持ったときに
  //    別のアカウント（tkp 側など）へ誤ってデプロイされうる。
  //    アカウントIDは秘密情報ではない（ダッシュボードのURLに出る値）。
  "account_id": "f1ef33518ca7a7621b0d1c3de3d1e533",

  // workers.dev のURLを有効にする。独自ドメインに移行してもここは残してよい。
  "workers_dev": true,

  "assets": {
    "directory": "./dist",

    // 1ページサイト。存在しないパスは 404.html を 404 ステータスで返す。
    // ⚠ "single-page-application" にするとトップを 200 で返す「ソフト404」になり、
    //    Google のインデックス品質が落ちるので使わない。
    "not_found_handling": "404-page"
  }
}
